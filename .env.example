# Copy this file to .env and replace the placeholder with a random value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
IQT02_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
IQT02_DATABASE_PATH=./data/iqterra.sqlite3
IQT02_UPLOAD_DIR=./data/uploads
APP_PORT=8000
# Gmail address used to send student invitations.
IQT02_SMTP_USERNAME=
# Put the Google app password in APP=... in your private .env file. Never commit it.
# Student invitation links must use the URL students can access after deployment.
IQT02_PUBLIC_URL=
