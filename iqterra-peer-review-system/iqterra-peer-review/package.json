{
  "name": "iqterra-peer-review",
  "private": true,
  "type": "module",
  "workspaces": ["pkg/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:lti": "tsx apps/lti-service/src/server.ts",
    "dev:ui": "astro dev --root apps/reviewer-ui",
    "build:ui": "astro build --root apps/reviewer-ui",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "astro": "^5.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.12",
    "zod": "^3.24.1"
  }
}
