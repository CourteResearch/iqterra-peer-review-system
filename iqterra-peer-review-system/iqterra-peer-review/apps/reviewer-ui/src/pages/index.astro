---
const steps = [
  ['01', 'Review queue', 'Show only the submissions allocated to the authenticated reviewer.'],
  ['02', 'Rubric', 'Capture criterion scores and evidence without exposing sensitive allocation rules.'],
  ['03', 'Moderation', 'Route flags to a tenant-scoped moderator before grades are passed back.'],
];
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>IQTerra Peer Review</title></head>
  <body>
    <main>
      <p class="eyebrow">IQT-02 · LTI peer review service</p>
      <h1>Peer review that stays inside IQTerra.</h1>
      <p class="lede">This Astro shell is ready for the reviewer workflow. Moodle launches the service; allocation, rubric and moderation remain on this side of the boundary.</p>
      <section class="grid">
        {steps.map(([number, title, text]) => <article><span>{number}</span><h2>{title}</h2><p>{text}</p></article>)}
      </section>
      <p class="status">Prototype status: allocation API available at <code>/api/allocations/preview</code>.</p>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; } :global(body) { margin: 0; background: #10161b; color: #edf4ed; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  main { max-width: 1050px; margin: 0 auto; padding: 12vh 7vw; } .eyebrow { color: #91d6a0; letter-spacing: .12em; text-transform: uppercase; font-size: .78rem; font-weight: 700; }
  h1 { max-width: 760px; font-size: clamp(3rem, 8vw, 7rem); line-height: .95; letter-spacing: -.06em; margin: 2rem 0; } .lede { max-width: 650px; color: #b5c3ba; font-size: 1.2rem; line-height: 1.6; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 5rem; } article { border: 1px solid #334239; padding: 1.5rem; min-height: 220px; background: #16211b; } article span { color: #91d6a0; } h2 { margin-top: 3rem; } article p { color: #b5c3ba; line-height: 1.5; } .status { margin-top: 4rem; color: #91d6a0; } code { color: #fff; }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
</style>
